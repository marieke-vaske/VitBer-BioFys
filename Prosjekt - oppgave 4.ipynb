    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import math\n",
    "\n",
    "def J_avg(alpha, T_p, N_x):\n",
    "    J = (N_x/4*T_p)*(math.erfc((alpha*N_x/2)*np.sqrt(3/T_p)) - math.erfc(((1-alpha)*N_x/2)*np.sqrt(3/T_p)))\n",
    "    return J\n"
   ]
